  <property name="styleSheet">
   <string notr="true">QWidget#HelpWidget {
    background: #f7f8fa;
    color: #202124;
    font-family: &quot;Malgun Gothic&quot;;
    font-size: 10pt;
}
QFrame#headerFrame, QFrame#quickStartFrame {
    background: #ffffff;
    border: 1px solid #d9dde3;
    border-radius: 8px;
}
QLabel#titleLabel {
    color: #1f2937;
    font-size: 18pt;
    font-weight: 700;
}
QLabel#subtitleLabel {
    color: #626b75;
    font-size: 10pt;
}
QLabel#quickStartTitleLabel {
    color: #244d73;
    font-weight: 700;
}
QLabel#quickStartFlowLabel {
    color: #2f3e4d;
    font-weight: 600;
}
QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #cfd5dc;
    top: -1px;
}
QTabBar::tab {
    background: #edf1f5;
    color: #49535e;
    border: 1px solid #cfd5dc;
    border-bottom: none;
    min-width: 120px;
    padding: 10px 18px;
    margin-right: 2px;
}
QTabBar::tab:selected {
    background: #ffffff;
    color: #244d73;
    font-weight: 700;
}
QTabBar::tab:hover:!selected {
    background: #e3e9ef;
}
QTextBrowser {
    background: #ffffff;
    border: none;
    selection-background-color: #b9d5f2;
}
QLabel#sectionLabel, QLabel#versionLabel {
    color: #707780;
    font-size: 9pt;
}
QPushButton#closeButton {
    background: #ffffff;
    border: 1px solid #bfc6cf;
    border-radius: 6px;
    min-width: 90px;
    padding: 7px 14px;
}
QPushButton#closeButton:hover {
    background: #eef2f6;
}</string>
